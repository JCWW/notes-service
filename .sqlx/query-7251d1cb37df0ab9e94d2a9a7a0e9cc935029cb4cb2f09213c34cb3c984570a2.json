  "query": "\n        SELECT t.id AS \"id!\", t.name AS \"name!\", t.slug AS \"slug!\",\n               t.created_at AS \"created_at!\"\n        FROM teams t\n        JOIN team_members m ON m.team_id = t.id\n        WHERE m.user_id = $1\n        ORDER BY t.name\n        ",
