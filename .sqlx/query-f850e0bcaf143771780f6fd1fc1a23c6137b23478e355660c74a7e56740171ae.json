{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE notes\n        SET title      = COALESCE($2::text, title),\n            body       = COALESCE($3::text, body),\n            version    = version + 1,\n            updated_at = now()\n        WHERE id = $1 AND deleted_at IS NULL\n        RETURNING id, author_id, team_id, title, body, version, created_at, updated_at\n        ",
