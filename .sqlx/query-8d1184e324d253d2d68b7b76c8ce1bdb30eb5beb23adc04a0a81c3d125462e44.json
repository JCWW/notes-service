  "query": "\n        SELECT m.user_id AS \"user_id!\",\n               u.display_name AS \"display_name!\",\n               m.role AS \"role!: TeamRole\",\n               m.joined_at AS \"joined_at!\"\n        FROM team_members m\n        JOIN users u ON u.id = m.user_id\n        WHERE m.team_id = $1\n        ORDER BY u.display_name\n        ",
