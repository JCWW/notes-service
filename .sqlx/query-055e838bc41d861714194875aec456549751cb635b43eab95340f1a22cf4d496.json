  "query": "\n        SELECT id, author_id, team_id, title, body, version, created_at, updated_at\n        FROM notes\n        WHERE author_id = $1 AND deleted_at IS NULL\n        ORDER BY updated_at DESC, id DESC\n        LIMIT $2\n        ",
